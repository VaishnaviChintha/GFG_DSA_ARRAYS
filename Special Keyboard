import java.util.*;
class Solution {
    public int optimalKeys(int n) {
        // code here
        int[] dp = new int[n+1];
        for(int i=0;i<=n;i++){
            dp[i]=i;
            for(int j=1;j<=(i-3);j++){
                dp[i]=Math.max(dp[i],dp[j]*(i-j-1));
            }
        }
        return dp[n];
    }
 public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        System.out.println(optimalKeys(n));
    }
}
