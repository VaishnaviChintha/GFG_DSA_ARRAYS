import java.util.*;
class Solution {
    public int maxSum(int n) {
        // code here.
        return recursive(n,0);
    }
    public int recursive(int n,int sum){
        if(n<=0){
            return sum;
        }
        sum=recursive(n/2,0)+recursive(n/3,0)+recursive(n/4,0);
        return Math.max(n,sum);
    }
public static void main(String[] args) {

        Solution obj = new Solution();

        int n = 12;

        int ans = obj.maxSum(n);

        System.out.println("Maximum Sum = " + ans);
    }
}
