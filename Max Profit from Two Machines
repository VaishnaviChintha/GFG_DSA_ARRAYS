import java.util.*;
class Solution {
    public int maxProfit(int x, int y, int[] a, int[] b) {
        // code here
        int n = a.length;
        Integer[] idx = new Integer[n];
        for (int i = 0; i < n; i++) {
            idx[i] = i;
        }
        Arrays.sort(idx, (i, j) ->
            Math.abs(b[j] - a[j]) - Math.abs(b[i] - a[i])
        );
        int profit = 0;
        for (int i : idx) {
            if ((a[i] >= b[i] && x > 0) || y == 0) {
                profit += a[i];
                x--;
            }
            else {
                profit += b[i];
                y--;
            }
        }

        return profit;
    }
public static void main(String[] args) {
        int x = 3, y = 3;
        int[] a = {1, 2, 3, 4, 5};
        int[] b = {5, 4, 3, 2, 1};
        System.out.println(maxProfit(x, y, a, b));
    }
}
